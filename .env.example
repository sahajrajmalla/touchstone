# Touchstone configuration.
# `make setup` copies this file to .env - then fill in the keys below.
# .env is git-ignored: never commit real keys. Check your setup with `make doctor`.

# --- Language models (required) ----------------------------------------------
# The default models are Anthropic Claude. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Embeddings (required for indexing and retrieval) ------------------------
# Google Gemini API key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# --- Elasticsearch (required for indexing and retrieval) ---------------------
# `make es-up` starts a local Elasticsearch in Docker using this password.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=change-me-please
# Interface the Docker container publishes port 9200 on. Use 0.0.0.0 if the
# LangGraph server itself runs inside Docker (see docs/elasticsearch.md).
# ELASTICSEARCH_BIND=127.0.0.1

# --- Optional ----------------------------------------------------------------
# Web search for the agents: https://tavily.com/ (without it, web search is unavailable)
TAVILY_API_KEY=
# Default user id when none is given in the run configuration or the UI.
USER_ID=
# LangSmith tracing: https://smith.langchain.com/
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=touchstone

# --- Web UI --------------------------------------------------------------------
# Where the UI finds the LangGraph server started by `make dev`.
TOUCHSTONE_API_URL=http://127.0.0.1:2024
